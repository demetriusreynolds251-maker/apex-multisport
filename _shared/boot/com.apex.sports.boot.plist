<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apex.sports.boot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/path/to/home/ApexSports/_shared/boot/apex_boot.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/path/to/home/ApexSports</string>
	<key>StandardOutPath</key>
	<string>/path/to/home/ApexSports/_shared/boot/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/home/ApexSports/_shared/boot/launchd.log</string>
</dict>
</plist>
