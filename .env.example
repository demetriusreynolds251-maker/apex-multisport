# Each sport's common.secret(name) checks an env var first, then
# <sport>/secrets/<name> (ignored by .gitignore). Env var = file name
# without extension, upper-cased. Use one bot per sport, so set these
# per process (for example in that sport's discord/start.sh).
DISCORD_BOT_TOKEN=your-discord-bot-token
THEODDSGAP_KEY=your-theoddsgap-key
ODDS_API_KEY=your-the-odds-api-key

# Discord ids (set in each <sport>/config/sport.json "guild_id",
# and for basketball/discord/bot.py via these env vars)
DISCORD_GUILD_ID=0
DISCORD_CLIENT_ID=0
